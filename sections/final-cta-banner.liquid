{%- style -%}
  .final-cta--{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.banner_height }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #1C1D1D;
  }

  .final-cta__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .final-cta__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final-cta__overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 29, 29, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  .final-cta__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 80rem;
    padding: 6rem 2rem;
    color: #FFFFFF;
  }

  .final-cta__heading {
    font-size: calc(var(--font-heading-scale) * 4rem);
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 1.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .final-cta__heading {
      font-size: calc(var(--font-heading-scale) * 5.6rem);
    }
  }

  .final-cta__subtext {
    font-size: 1.8rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 auto 3.6rem;
    max-width: 54rem;
    line-height: 1.5;
  }

  .final-cta__button {
    min-width: 20rem;
  }
{%- endstyle -%}

<div class="final-cta final-cta--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="final-cta__media">
    {%- if section.settings.image != blank -%}
      {%- assign cta_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {% render 'responsive-image', image: section.settings.image, sizes: '100vw', alt: cta_alt %}
    {%- else -%}
      <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #1C1D1D 0%, #2D4030 50%, #1E2B20 100%);"></div>
    {%- endif -%}
  </div>

  <div class="final-cta__overlay"></div>

  <div class="final-cta__content page-width">
    <h2 class="final-cta__heading">{{ section.settings.heading | escape }}</h2>

    {%- if section.settings.subtext != blank -%}
      <div class="final-cta__subtext rte">{{ section.settings.subtext }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="button button--secondary final-cta__button">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Final CTA Banner",
  "tag": "section",
  "class": "section-final-cta",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 50
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where will you go next?"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Equip your companion with travel gear designed for a lifetime of shared adventures.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Canitera"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "50vh", "label": "Medium (50vh)" },
        { "value": "70vh", "label": "Large (70vh)" },
        { "value": "90vh", "label": "Full (90vh)" }
      ],
      "default": "70vh"
    }
  ],
  "presets": [
    {
      "name": "Final CTA Banner"
    }
  ]
}
{% endschema %}
