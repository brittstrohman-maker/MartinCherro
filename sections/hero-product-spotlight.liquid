{%- style -%}
  .product-spotlight--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-spotlight__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .product-spotlight__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 6rem;
    }
  }

  .product-spotlight__media {
    position: relative;
    border-radius: var(--media-radius, 8px);
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.03);
    aspect-ratio: 1 / 1;
  }

  .product-spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-spotlight__info {
    display: flex;
    flex-direction: column;
  }

  .product-spotlight__badge {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    margin-bottom: 1.2rem;
  }

  .product-spotlight__title {
    font-size: calc(var(--font-heading-scale) * 3.4rem);
    margin: 0 0 1.2rem;
    color: rgb(var(--color-foreground));
    line-height: 1.15;
  }

  .product-spotlight__price {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
  }

  .product-spotlight__price-compare {
    text-decoration: line-through;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .product-spotlight__desc {
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.8);
    margin-bottom: 2.4rem;
  }

  .product-spotlight__form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-spotlight__actions {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .product-spotlight__qty {
    display: flex;
    align-items: center;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: var(--inputs-radius, 4px);
    width: 12rem;
    height: 4.8rem;
  }

  .product-spotlight__qty-btn {
    width: 3.6rem;
    height: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground));
  }

  .product-spotlight__qty-input {
    width: 4.8rem;
    height: 100%;
    border: none;
    text-align: center;
    font-size: 1.6rem;
    background: transparent;
    color: rgb(var(--color-foreground));
  }

  .product-spotlight__atc {
    flex: 1;
    min-width: 200px;
    height: 4.8rem;
  }

  .product-spotlight__note {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.7);
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
{%- endstyle -%}

{%- assign spotlight_product = section.settings.product -%}

<div class="product-spotlight product-spotlight--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="product-spotlight__grid">
      <div class="product-spotlight__media">
        {%- if spotlight_product != blank and spotlight_product.featured_image != blank -%}
          {%- assign img_alt = spotlight_product.featured_image.alt | default: spotlight_product.title | escape -%}
          {% render 'responsive-image', image: spotlight_product.featured_image, sizes: '(min-width: 750px) 50vw, 100vw', alt: img_alt %}
        {%- elsif section.settings.fallback_image != blank -%}
          {%- assign img_alt = section.settings.fallback_image.alt | default: section.settings.heading | escape -%}
          {% render 'responsive-image', image: section.settings.fallback_image, sizes: '(min-width: 750px) 50vw, 100vw', alt: img_alt %}
        {%- else -%}
          <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #FAF8F5 0%, #D9CBB8 100%); display: flex; align-items: center; justify-content: center;">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product-spotlight__info">
        {%- if section.settings.badge != blank -%}
          <span class="product-spotlight__badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}

        <h2 class="product-spotlight__title">
          {%- if spotlight_product != blank -%}
            {{ spotlight_product.title | escape }}
          {%- else -%}
            {{ section.settings.heading | escape }}
          {%- endif -%}
        </h2>

        {% render 'rating-stars', rating: 4.9, count: 128, show_badge: true %}

        <div class="product-spotlight__price">
          {%- if spotlight_product != blank -%}
            <span>{{ spotlight_product.price | money }}</span>
            {%- if spotlight_product.compare_at_price > spotlight_product.price -%}
              <span class="product-spotlight__price-compare">{{ spotlight_product.compare_at_price | money }}</span>
            {%- endif -%}
          {%- else -%}
            <span>€89.00</span>
            <span class="product-spotlight__price-compare">€109.00</span>
          {%- endif -%}
        </div>

        <div class="product-spotlight__desc rte">
          {%- if spotlight_product != blank and spotlight_product.description != blank -%}
            {{ spotlight_product.description | truncatewords: 30 }}
          {%- else -%}
            {{ section.settings.description }}
          {%- endif -%}
        </div>

        {%- if spotlight_product != blank -%}
          {%- form 'product', spotlight_product, class: 'product-spotlight__form' -%}
            <input type="hidden" name="id" value="{{ spotlight_product.selected_or_first_available_variant.id }}">
            <div class="product-spotlight__actions">
              <div class="product-spotlight__qty">
                <button type="button" class="product-spotlight__qty-btn" onclick="this.nextElementSibling.stepDown()">−</button>
                <input type="number" name="quantity" value="1" min="1" class="product-spotlight__qty-input" aria-label="Quantity">
                <button type="button" class="product-spotlight__qty-btn" onclick="this.previousElementSibling.stepUp()">+</button>
              </div>
              <button type="submit" name="add" class="button button--primary product-spotlight__atc">
                <span>Add to Cart</span>
              </button>
            </div>
          {%- endform -%}
        {%- else -%}
          <div class="product-spotlight__actions">
            <a href="/collections/all" class="button button--primary product-spotlight__atc">
              Shop Featured Gear
            </a>
          </div>
        {%- endif -%}

        <div class="product-spotlight__note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Free shipping over €75 • 30-day adventure trial</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Product Spotlight",
  "tag": "section",
  "class": "section-product-spotlight",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback lifestyle image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "The Canitera Essential"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The All-Terrain Travel Bed"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Engineered for the backseat, campsites, and hotel rooms. Waterproof base, memory-foam core, and machine-washable outer shell that rolls into an effortless carry roll.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Hero Product Spotlight"
    }
  ]
}
{% endschema %}
