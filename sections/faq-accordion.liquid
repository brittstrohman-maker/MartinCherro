{%- style -%}
  .faq-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .faq-section__header {
    text-align: center;
    max-width: 64rem;
    margin: 0 auto 5rem;
  }

  .faq-section__eyebrow {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    margin-bottom: 1rem;
    display: block;
  }

  .faq-section__title {
    font-size: calc(var(--font-heading-scale) * 3.4rem);
    color: rgb(var(--color-foreground));
    margin: 0 0 1rem;
  }

  .faq-section__subtitle {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.75);
    margin: 0;
  }

  .faq-section__container {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .faq-item {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--media-radius, 8px);
    background-color: rgb(var(--color-background));
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: rgba(var(--color-button), 0.4);
  }

  .faq-item__summary {
    padding: 2.2rem 2.4rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.6rem;
    font-size: 1.7rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    list-style: none;
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-item__icon {
      transform: none;
    }
  }

  .faq-item__content {
    padding: 0 2.4rem 2.4rem;
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.8);
  }

  .faq-item__category-badge {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(var(--color-button));
    font-weight: 600;
    margin-bottom: 0.6rem;
    display: inline-block;
  }
{%- endstyle -%}

<div class="faq-section faq-section--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="faq-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="faq-section__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="faq-section__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="faq-section__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-section__container">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-item__summary">
            <div>
              {%- if block.settings.category != blank -%}
                <span class="faq-item__category-badge">{{ block.settings.category | escape }}</span>
              {%- endif -%}
              <div>{{ block.settings.question | escape }}</div>
            </div>
            <span class="faq-item__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-item__content rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Answers For The Road"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Frequently Asked Questions",
      "default": "Everything You Need to Know"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Have a question about sizing, travel safety, or shipping? Find answers below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Travel Safety"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products suitable for car travel?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. All Canitera travel restraints and seat protectors are engineered specifically for vehicle transit, using heavy-duty webbing, reinforced stitching, and universal ISOFIX/seatbelt anchor points.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "category": "Orders & Shipping",
            "question": "How long does shipping take?",
            "answer": "<p>Standard delivery across Europe takes 2–4 business days. We offer free shipping on all orders over €75.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "Products & Sizing",
            "question": "How do I choose the correct size for my dog?",
            "answer": "<p>Each product page includes our interactive sizing guide. Measure your dog's chest circumference and length from collar to tail base for the best fit.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "Care & Cleaning",
            "question": "How do I clean Canitera gear after muddy adventures?",
            "answer": "<p>Our beds, mats, and seat liners feature removable covers that are 100% machine-washable at 30°C. For mud and sand, wipe down with a damp cloth.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "Returns & Warranty",
            "question": "What is your 30-day adventure trial?",
            "answer": "<p>Take our gear on your next trip. If it doesn't make travelling with your dog significantly easier and more comfortable, return it within 30 days for a full refund.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
