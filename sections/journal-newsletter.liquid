{%- style -%}
  .journal-newsletter--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--color-background);
  }

  .journal-newsletter__container {
    max-width: 68rem;
    margin: 0 auto;
    text-align: center;
    padding: 4.8rem 2.4rem;
    border-radius: var(--media-radius, 8px);
    background-color: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.06);
  }

  .journal-newsletter__eyebrow {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    margin-bottom: 1rem;
    display: block;
  }

  .journal-newsletter__title {
    font-size: calc(var(--font-heading-scale) * 3.4rem);
    color: rgb(var(--color-foreground));
    margin: 0 0 1.4rem;
    line-height: 1.15;
  }

  .journal-newsletter__subtext {
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0 auto 3rem;
    max-width: 52rem;
  }

  .journal-newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 600px) {
    .journal-newsletter__form {
      flex-direction: row;
    }
  }

  .journal-newsletter__input-wrap {
    flex: 1;
  }

  .journal-newsletter__input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.6rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: var(--inputs-radius, 4px);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.5rem;
  }

  .journal-newsletter__button {
    height: 4.8rem;
    white-space: nowrap;
    padding: 0 2.8rem;
  }

  .journal-newsletter__note {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.55);
    margin: 1.6rem 0 0;
  }
{%- endstyle -%}

<div class="journal-newsletter journal-newsletter--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="journal-newsletter__container">
      {%- if section.settings.eyebrow != blank -%}
        <span class="journal-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h2 class="journal-newsletter__title">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.subtext != blank -%}
        <div class="journal-newsletter__subtext rte">{{ section.settings.subtext }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'journal-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, canitera_journal">
        
        <div class="journal-newsletter__input-wrap">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email address</label>
          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="journal-newsletter__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
            {% endif %}
            placeholder="Enter your email"
            required
          >
        </div>

        <button type="submit" class="button button--primary journal-newsletter__button" name="commit">
          {{ section.settings.button_label | default: 'Join the Journal' | escape }}
        </button>

        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" tabindex="-1" autofocus>
            Welcome to the Canitera Journal. Look out for our next travel dispatch!
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}
        <p class="journal-newsletter__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Journal Newsletter",
  "tag": "section",
  "class": "section-journal-newsletter",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Canitera Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More miles. More memories."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Join the Canitera journal for travel inspiration, destination checklists, practical road-trip advice, and private seasonal releases.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join Journal"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Privacy note",
      "default": "No spam. Unsubscribe anytime with one click."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Journal Newsletter"
    }
  ]
}
{% endschema %}
