{%- style -%}
  .shop-adventure--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .shop-adventure__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 4rem;
  }

  .shop-adventure__title {
    font-size: calc(var(--font-heading-scale) * 3rem);
    margin: 0 0 1rem;
    color: rgb(var(--color-foreground));
  }

  .shop-adventure__subtitle {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.75);
    margin: 0;
  }

  .shop-adventure__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 600px) {
    .shop-adventure__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .shop-adventure__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 2 | at_most: 4 }}, 1fr);
      gap: 2.4rem;
    }
  }

  .shop-adventure__card {
    position: relative;
    border-radius: var(--media-radius, 8px);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    display: block;
    background-color: #1C1D1D;
  }

  .shop-adventure__card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-adventure__card:hover .shop-adventure__card-media {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-adventure__card:hover .shop-adventure__card-media {
      transform: none;
    }
  }

  .shop-adventure__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-adventure__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 29, 29, 0.1) 0%, rgba(28, 29, 29, 0.75) 100%);
    z-index: 1;
  }

  .shop-adventure__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.4rem;
    z-index: 2;
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .shop-adventure__card-title {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #FFFFFF;
    margin: 0 0 0.4rem;
  }

  .shop-adventure__card-desc {
    font-size: 1.3rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .shop-adventure__card-arrow {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #FFFFFF;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .shop-adventure__card:hover .shop-adventure__card-arrow {
    background: #FFFFFF;
    color: #1C1D1D;
    transform: translateX(4px);
  }
{%- endstyle -%}

<div class="shop-adventure shop-adventure--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="shop-adventure__header">
        <h2 class="shop-adventure__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="shop-adventure__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="shop-adventure__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '/collections/all' }}" class="shop-adventure__card" {{ block.shopify_attributes }}>
          <div class="shop-adventure__card-media">
            {%- if block.settings.image != blank -%}
              {%- assign card_alt = block.settings.image.alt | default: block.settings.title | escape -%}
              {% render 'responsive-image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw', alt: card_alt %}
            {%- else -%}
              <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #2D4030 0%, #1C1D1D 100%);"></div>
            {%- endif -%}
          </div>
          <div class="shop-adventure__card-overlay"></div>
          <div class="shop-adventure__card-content">
            <div>
              <h3 class="shop-adventure__card-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="shop-adventure__card-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
            <div class="shop-adventure__card-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop By Adventure",
  "tag": "section",
  "class": "section-shop-adventure",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Adventure"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Gear curated for every destination and terrain"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "adventure_card",
      "name": "Adventure Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Road Trips"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Car seats, restraints & boot liners"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Adventure",
      "blocks": [
        {
          "type": "adventure_card",
          "settings": {
            "title": "Road Trips",
            "description": "Safe travel restraints & seat protectors"
          }
        },
        {
          "type": "adventure_card",
          "settings": {
            "title": "Weekend Getaways",
            "description": "Packable beds & travel bowls"
          }
        },
        {
          "type": "adventure_card",
          "settings": {
            "title": "Beach Days",
            "description": "Quick-dry towels & waterproof gear"
          }
        },
        {
          "type": "adventure_card",
          "settings": {
            "title": "Outdoor Adventures",
            "description": "Hiking harnesses & hydration packs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
