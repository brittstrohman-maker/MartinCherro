{%- style -%}
  .brand-story--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .brand-story__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .brand-story__container {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .brand-story__media {
    position: relative;
    border-radius: var(--media-radius, 8px);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: rgba(var(--color-foreground), 0.04);
  }

  .brand-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-story__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FAF8F5 0%, #D9CBB8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1C1D1D;
  }

  .brand-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-story__badge {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    margin-bottom: 1.2rem;
  }

  .brand-story__heading {
    font-size: calc(var(--font-heading-scale) * 3.2rem);
    line-height: 1.15;
    margin: 0 0 2rem;
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .brand-story__heading {
      font-size: calc(var(--font-heading-scale) * 4.2rem);
    }
  }

  .brand-story__text {
    font-size: 1.6rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.85);
    margin: 0 0 3rem;
  }

  .brand-story__cta {
    align-self: flex-start;
  }
{%- endstyle -%}

<div class="brand-story brand-story--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="brand-story__container{% if section.settings.layout == 'image_second' %} brand-story__container--reverse{% endif %}">
      {%- if section.settings.layout == 'image_first' -%}
        <div class="brand-story__media">
          {%- if section.settings.image != blank -%}
            {%- assign image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
            {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw', alt: image_alt %}
          {%- else -%}
            <div class="brand-story__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="brand-story__content">
        {%- if section.settings.badge != blank -%}
          <span class="brand-story__badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}
        <h2 class="brand-story__heading">{{ section.settings.heading | escape }}</h2>
        <div class="brand-story__text rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="button button--primary brand-story__cta">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.layout == 'image_second' -%}
        <div class="brand-story__media">
          {%- if section.settings.image != blank -%}
            {%- assign image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
            {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw', alt: image_alt %}
          {%- else -%}
            <div class="brand-story__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story Split",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image placement",
      "options": [
        { "value": "image_first", "label": "Image left, text right" },
        { "value": "image_second", "label": "Text left, image right" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow badge",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the journey."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story copy",
      "default": "<p>Canitera was created for the moments that happen beyond the front door — the road trips, early-morning walks, weekends away, and spontaneous detours. We believe dogs belong wherever life takes us.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Brand Story Split"
    }
  ]
}
{% endschema %}
