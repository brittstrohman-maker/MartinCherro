{% comment %}
  Renders accessible star ratings for products, cards, and testimonials.

  Accepts:
  - rating: {Number|Object} Rating value (e.g. 4.8, 5) or metafield object.
  - rating_count: {Number|String} Total review count (optional).
  - rating_max: {Number} Scale maximum (default: 5).
  - class: {String} Additional CSS classes (optional).
  - show_count: {Boolean} Show review count (default: true).
  - show_empty_stars: {Boolean} Render empty stars (default: true).

  Usage:
  {% render 'rating-stars', rating: product.metafields.reviews.rating.value, rating_count: product.metafields.reviews.rating_count %}
  {% render 'rating-stars', rating: 4.8, rating_count: 36, class: 'testimonial__rating' %}
{% endcomment %}

{%- liquid
  assign rating_val = 0.0
  if rating != blank
    if rating.rating != blank
      assign rating_val = rating.rating | plus: 0.0
    elsif rating.value != blank and rating.value.rating != blank
      assign rating_val = rating.value.rating | plus: 0.0
    else
      assign rating_val = rating | plus: 0.0
    endif
  endif

  assign max_rating = 5.0
  if rating_max != blank
    assign max_rating = rating_max | plus: 0.0
  elsif rating.scale_max != blank
    assign max_rating = rating.scale_max | plus: 0.0
  elsif rating.value != blank and rating.value.scale_max != blank
    assign max_rating = rating.value.scale_max | plus: 0.0
  endif

  if rating_val > max_rating
    assign rating_val = max_rating
  elsif rating_val < 0.0
    assign rating_val = 0.0
  endif

  assign rounded_rating = rating_val | times: 2 | round | divided_by: 2.0
  assign max_stars_int = max_rating | round

  assign count_val = 0
  if rating_count != blank
    assign count_val = rating_count | plus: 0
  elsif rating.count != blank
    assign count_val = rating.count | plus: 0
  elsif rating.value != blank and rating.value.rating_count != blank
    assign count_val = rating.value.rating_count | plus: 0
  endif
-%}

<div
  class="rating-stars{% if class != blank %} {{ class }}{% endif %}"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_val, rating_max: max_stars_int }}"
>
  <div class="rating-stars__icons" aria-hidden="true">
    {%- for i in (1..max_stars_int) -%}
      {%- assign diff = rounded_rating | minus: i -%}
      {%- if diff >= 0 -%}
        <!-- Full Star -->
        <svg class="rating-star-icon rating-star-icon--full" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M10 1.5l2.47 5.01 5.53.8-4 3.9 1 5.51L10 14.12l-5 2.6 1-5.51-4-3.9 5.53-.8L10 1.5z"/>
        </svg>
      {%- elsif diff == -0.5 -%}
        <!-- Half Star (ID-free split path) -->
        <svg class="rating-star-icon rating-star-icon--half" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M10 1.5v12.62l-5 2.6 1-5.51-4-3.9 5.53-.8L10 1.5z"/>
          <path fill="rgba(var(--color-foreground), 0.18)" d="M10 1.5l2.47 5.01 5.53.8-4 3.9 1 5.51L10 14.12V1.5z"/>
        </svg>
      {%- else -%}
        <!-- Empty Star -->
        {%- if show_empty_stars != false -%}
          <svg class="rating-star-icon rating-star-icon--empty" viewBox="0 0 20 20" width="16" height="16" fill="rgba(var(--color-foreground), 0.18)" aria-hidden="true" focusable="false">
            <path d="M10 1.5l2.47 5.01 5.53.8-4 3.9 1 5.51L10 14.12l-5 2.6 1-5.51-4-3.9 5.53-.8L10 1.5z"/>
          </svg>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if count_val > 0 and show_count != false -%}
    <span class="rating-stars__count caption" aria-hidden="true">({{ count_val }})</span>
    <span class="visually-hidden">
      {{ count_val }} {{ 'accessibility.total_reviews' | t | default: 'reviews' }}
    </span>
  {%- endif -%}
</div>
